{
  "name": "harutv",
  "version": "0.4.0",
  "private": true,
  "description": "haruTV — 留一点时间，给好故事",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "next dev -p 8080",
    "build": "next build",
    "start": "next start -p 8080",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "desktop": "electron .",
    "desktop:dev": "node scripts/desktop-dev.cjs",
    "build:desktop": "node scripts/build-desktop.cjs",
    "build:win": "npm run build:desktop && electron-builder --win nsis",
    "pack:win": "npm run build:desktop && electron-builder --win --dir"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-virtual": "^3.14.12",
    "artplayer": "^5.2.3",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "hls.js": "^1.5.17",
    "mpegts.js": "^1.8.2",
    "mux.js": "^6.3.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici": "^6.21.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.24",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.25",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "main": "desktop/main.cjs",
  "author": "haruTV contributors",
  "build": {
    "appId": "app.haru.tv",
    "productName": "haruTV",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "server",
        "filter": [
          "**/*",
          "!**/.env*"
        ]
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "NOTICE.md",
        "to": "NOTICE.md"
      },
      {
        "from": "DATA-LICENSE.md",
        "to": "DATA-LICENSE.md"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/harutv.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "haruTV"
    },
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "afterPack": "scripts/after-pack.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/scj040921/haruTV.git"
  },
  "homepage": "https://github.com/scj040921/haruTV",
  "bugs": {
    "url": "https://github.com/scj040921/haruTV/issues"
  }
}
